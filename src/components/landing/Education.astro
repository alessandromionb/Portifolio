---
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import { getContent } from "@/lib/getContent";

const education = [
  {
    period: "2024–2027 • 6º período — cursando",
    title: "Sistemas de Informação — Bacharelado",
    description:
      "Instituto Federal do Espírito Santo (IFES).",
    category: "Bacharelado",
  },
  {
    period: "Emitido em jun. de 2026",
    title: "Google Cybersecurity Professional Certificate",
    description: "Google • Código: 5TCGBI3B0SMP",
    category: "Certificado",
    credentialUrl:
      "https://www.coursera.org/account/accomplishments/specialization/5TCGBI3B0SMP",
  },
  {
    period: "Emitido em jun. de 2026",
    title: "Certified Ethical Hacker (CEH)",
    description: "Cisco Networking Academy",
    category: "Certificado",
    credentialUrl:
      "https://www.credly.com/badges/f1ede8a7-eaca-43ad-827d-37af17d2b96a",
  },
  {
    period: "Emitido em dez. de 2025",
    title: "CCNA: Introduction to Networks",
    description: "Cisco Networking Academy",
    category: "Certificado",
    credentialUrl:
      "https://www.credly.com/badges/8c3ebc0a-abca-437d-b5cf-524b51f53197/public_url",
  },
];
const educationEyebrowDefault = "Formação acadêmica";
---

<section class="scroll-mt-32" id="education">
  <Wrapper variant="standard" class="py-12 lg:py-24">
    <div class="grid grid-cols-1 lg:grid-cols-4 items-start">
      <div class="lg:col-start-2">
        <Text
          tag="p"
          variant="textSM"
          class="text-base-600 dark:text-base-300"
          data-editable="sections.education.eyebrow"
        >
          {getContent("sections.education.eyebrow", educationEyebrowDefault)}
        </Text>
      </div>

      <Text
        tag="h2"
        variant="textXL"
        class="font-semibold leading-snug tracking-tighter lg:col-span-2 text-base-900 dark:text-white"
        data-editable="sections.education.title"
      >
        {getContent("sections.education.title", "Educação")}
      </Text>
    </div>

    <div class="flex flex-col gap-12 mt-12">
      {
        education.map((item, index) => (
          <article class="py-12 border-t border-base-200 dark:border-base-800">
            <div class="grid grid-cols-1 gap-4 lg:grid-cols-4 items-start">
              <Text
                tag="p"
                variant="textXS"
                class="text-base-600 dark:text-base-300 uppercase"
                data-editable={`education.${index}.period`}
              >
                {getContent(`education.${index}.period`, item.period)}
              </Text>

              <Text
                tag="h3"
                variant="textLG"
                class="text-base-900 dark:text-white leading-tight font-semibold"
                data-editable={`education.${index}.title`}
              >
                {getContent(`education.${index}.title`, item.title)}
              </Text>

              <div>
                <Text
                  tag="p"
                  variant="textSM"
                  class="text-base-600 dark:text-base-300"
                  data-editable={`education.${index}.description`}
                >
                  {getContent(`education.${index}.description`, item.description)}
                </Text>
                {item.credentialUrl && (
                  <a
                    href={item.credentialUrl}
                    target="_blank"
                    rel="noreferrer"
                    class="mt-2 inline-block text-xs text-base-600 underline underline-offset-4 transition-colors hover:text-accent-700 dark:text-base-300 dark:hover:text-accent-400"
                  >
                    Exibir credencial ↗
                  </a>
                )}
              </div>

              <Text
                tag="p"
                variant="textXS"
                class="text-base-600 dark:text-base-300 uppercase lg:ml-auto lg:col-start-4"
                data-editable={`education.${index}.category`}
              >
                {getContent(`education.${index}.category`, item.category)}
              </Text>
            </div>
          </article>
        ))
      }
    </div>
  </Wrapper>
</section>
